FROM mirror.gcr.io/library/docker:29.10.0-cli AS docker-cli
FROM mirror.gcr.io/library/python:3.15.2-slim
ARG BUILD_TAG=1
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 APP_DATA_DIR=/app/data CASAOS_APPS_DIR=/var/lib/casaos/apps APPDATA_DIR=/DATA/AppData
WORKDIR /app
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker-cli /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/libexec/docker/cli-plugins/docker-compose
COPY wheels /wheels
COPY requirements.txt .
RUN pip install --no-cache-dir --no-index --find-links /wheels -r requirements.txt && rm -rf /wheels
COPY app/ ./app/
COPY assets/ ./assets/
RUN mkdir -p /app/data && echo "$BUILD_TAG" > /app/BUILD_TAG
LABEL org.opencontainers.image.version="0.13.$BUILD_TAG"
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
